# Copy this file to backend/.env and adjust values as needed.

# --- Database -----------------------------------------------------------------
# Default is a local SQLite file (no setup required).
# To use PostgreSQL instead, uncomment psycopg2-binary in requirements.txt and
# set DATABASE_URL=postgresql://user:password@localhost:5432/soc_assistant
DATABASE_URL=sqlite:///./soc_assistant.db

# --- Auth ---------------------------------------------------------------------
# Used to sign JWT access tokens. Replace with a long random string in any real deployment.
SECRET_KEY=change-me-in-production

# --- LLM (optional) -----------------------------------------------------------
# Get a free key at https://console.groq.com. Leave blank to run in demo mode
# (the orchestrator still classifies queries; agents return template responses).
GROQ_API_KEY=

# --- CORS ---------------------------------------------------------------------
# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# --- Password reset -----------------------------------------------------------
# "console" prints reset tokens to the backend log (good for local demo).
PASSWORD_RESET_TOKEN_MODE=console

# --- Demo users ---------------------------------------------------------------
# When true, seeds analyst@demo.local / admin@demo.local on first startup so the
# demo works without manual registration. Set to false to disable.
SEED_DEMO_USERS=true
